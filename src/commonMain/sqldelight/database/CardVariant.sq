CREATE TABLE CardVariantEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    nameOriginal TEXT NOT NULL,
    nameNormalized TEXT NOT NULL,
    setCode TEXT NOT NULL,
    sku TEXT NOT NULL,
    variantType TEXT NOT NULL,
    priceInCents INTEGER NOT NULL,
    collectorNumber TEXT,
    imageUrl TEXT,
    seller TEXT NOT NULL DEFAULT 'USEA',
    purchaseUri TEXT
);

CREATE INDEX idx_nameNormalized ON CardVariantEntity(nameNormalized);

CREATE UNIQUE INDEX idx_variant_seller_sku ON CardVariantEntity(seller, sku);

CREATE INDEX idx_seller ON CardVariantEntity(seller);

selectAll:
SELECT * FROM CardVariantEntity;

insertVariant:
INSERT OR REPLACE INTO CardVariantEntity (
    nameOriginal, nameNormalized, setCode, sku, variantType, priceInCents, collectorNumber, imageUrl, seller, purchaseUri
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getByName:
SELECT * FROM CardVariantEntity WHERE nameNormalized = ?;

deleteAll:
DELETE FROM CardVariantEntity;

countAll:
SELECT COUNT(*) FROM CardVariantEntity;

updateImageUrl:
UPDATE CardVariantEntity SET imageUrl = ? WHERE sku = ?;

selectBySeller:
SELECT * FROM CardVariantEntity WHERE seller = ?;

deleteAllBySeller:
DELETE FROM CardVariantEntity WHERE seller = ?;
